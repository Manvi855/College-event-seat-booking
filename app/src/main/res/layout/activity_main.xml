
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FAF8F3"
    android:padding="25dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CampusSeat"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#7B1E3A"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="College Event Seat Booking"
        android:textSize="16sp"
        android:textColor="#555555"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnBookSeats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Book Seats"
        android:backgroundTint="#7B1E3A"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnMyBookings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Bookings"
        android:layout_marginTop="15dp"
        android:backgroundTint="#D4AF37"
        android:textColor="#222222" />

</LinearLayout>
