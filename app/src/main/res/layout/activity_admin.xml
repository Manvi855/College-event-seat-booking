<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Event &amp; Booking Manager"
            android:textColor="#1E3A8A"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFormMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Mode: Add New Event"
            android:textColor="#0D9488"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etAdminTitle"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="Event Name"
            android:inputType="textCapWords"
            android:paddingHorizontal="10dp" />

        <EditText
            android:id="@+id/etAdminDescription"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:gravity="top"
            android:hint="Event Description"
            android:inputType="textMultiLine"
            android:padding="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etAdminDate"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="Date (YYYY-MM-DD)"
                android:paddingHorizontal="10dp" />

            <EditText
                android:id="@+id/etAdminTime"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="Time (e.g. 04:00 PM)"
                android:paddingHorizontal="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etAdminVenue"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="Venue"
                android:paddingHorizontal="10dp" />

            <Spinner
                android:id="@+id/spAdminCategory"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Assign Hall:"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spAdminHall"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbAdminIsPaid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paid Event" />

            <EditText
                android:id="@+id/etAdminFee"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@android:drawable/edit_text"
                android:hint="Fee in ₹ (0 if Free)"
                android:inputType="numberDecimal"
                android:paddingHorizontal="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAdminSaveEvent"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E3A8A"
                android:text="Add Event"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnAdminResetForm"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Clear Form" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAdminSelectEventToEditDelete"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#0D9488"
            android:text="Edit or Delete Existing Event"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Current Events"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdminEventsOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:textColor="#334155"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bookings Monitor"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdminBookingsMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:textColor="#334155"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>